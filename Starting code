import tkinter as tk
from tkinter import messagebox
from tkinter import font
from tkinter import ttk
import json
import os

class videoMedia_Logger(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("NotLetterBoxd")
        self.geometry("900x550")

#main layout(how the stuff is gonna be placed)
        self.left_frame = tk.Frame(self, padx=15, pady=15)
        self.left_frame.grid(row=0, column=0, sticky="n")

#inputs(Title, Release, Genre, Review/Notes)
        tk.Label(self.left_frame, text="Title").grid(row=0, column=0, sticky="w")
        self.title_entry = tk.Entry(self.left_frame, width=35)
        self.title_entry.grid(row=1, column=0, pady=5)

        tk.Label(self.left_frame, text="Release Date").grid(row=2, column=0, sticky="w")
        self.date_entry = tk.Entry(self.left_frame, width=35)
        self.date_entry.grid(row=3, column=0, pady=5)

        tk.Label(self.left_frame, text="Genre").grid(row=4, column=0, sticky="w")
        self.genre_entry = tk.Entry(self.left_frame, width=35)
        self.genre_entry.grid(row=5, column=0, pady=5)

        tk.Label(self.left_frame, text="Category").grid(row=6, column=0, sticky="w")

        self.category_var = tk.StringVar(value="Movie")
        categories = ["Movie", "TV Show", "Cartoon", "Anime", "Other"]
        tk.OptionMenu(self.left_frame, self.category_var, *categories).grid(row=7, column=0, pady=5, sticky="w")

        tk.Label(self.left_frame, text="Rating (1-5)").grid(row=8, column=0, sticky="w")

        self.rating_var = tk.IntVar(value=5)
        tk.OptionMenu(self.left_frame, self.rating_var, *range(1, 6)).grid(row=9, column=0, pady=5, sticky="w")

        tk.Label(self.left_frame, text="Review / Notes").grid(row=10, column=0, sticky="w")

        self.review_text = tk.Text(self.left_frame, height=10, width=30)
        self.review_text.grid(row=11, column=0, pady=5)

Video = videoMedia_Logger()
Video.mainloop()
