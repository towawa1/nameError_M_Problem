import tkinter as tk
from tkinter import messagebox
import json
import os

class videoMedia_Logger(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Video Media Logger")
        self.geometry("900x550")

#main layout(how the stuff is gonna be placed)
        self.left_frame = tk.Frame(self, padx=15, pady=15)
        self.left_frame.grid(row=0, column=0, sticky="n")

#inputs(Title, Release, Genre, Review/Notes)
        tk.Label(self.left_frame, text="Title").grid(row=0, column=0, sticky="w")
        self.title_entry = tk.Entry(self.left_frame, width=30)
        self.title_entry.grid(row=1, column=0, pady=5)


Video = videoMedia_Logger()
Video.mainloop()
