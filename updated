    # clear poster________________________________________________________________
    def clear_poster(self):
        try:
            selection_index = self.listbox.curselection()[0]
            selected_item_data = self.entries[selection_index]
            file_path = selected_item_data["poster"]

            if os.path.exists(file_path):
                self.poster_widget.config(image='',text='No poster available.')
                selected_item_data["poster"] = ""

                self.save_file()
